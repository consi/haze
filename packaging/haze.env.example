# Haze server configuration. Copy to /etc/haze/haze.env and edit as needed.
# The systemd unit picks this up via EnvironmentFile=-/etc/haze/haze.env.

# Bind address. Defaults to 127.0.0.1:4420 in the binary; the packaged
# service usually wants 0.0.0.0 so the UI is reachable on the network.
HAZE_BIND=0.0.0.0:4420

# Where SQLite and chunk files live. Matches systemd's StateDirectory=haze.
HAZE_DATA_DIR=/var/lib/haze

# tracing-subscriber directive. e.g. `haze=debug,info`.
HAZE_LOG=haze=info

# Public origin where users will reach the UI (scheme + host + optional port,
# no path). Required for WebAuthn passkeys; password login works without it.
# Must exactly match the URL in the browser address bar.
# HAZE_ORIGIN=https://haze.example.com
